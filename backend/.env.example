# ==============================================================================
# AARISHA STOREFRONT & CATALOGUE API — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env (or backend/.env) and populate the values.
# NEVER commit populated .env files containing secrets to version control.

# ── 1. Supabase Database Configuration ──
# Both Aarisha and AarishaAdmin connect to the same Supabase database.
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── 2. WhatsApp Order Dispatch ──
# WhatsApp number for receiving customer orders via wa.me links.
# Digits only with country code (e.g. 919924343003)
BRAND_WHATSAPP_NUMBER=919924343003

# ── 3. CORS Allowed Origins ──
# Comma-separated list of origins permitted to call this API.
# Add your production domain when deploying (e.g., https://yourdomain.com).
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ── 4. Instagram Feed Integration (Optional) ──
# 60-day long-lived Instagram Basic Display token from Meta for Developers.
# Leave blank to render luxury placeholder photography tiles.
INSTAGRAM_ACCESS_TOKEN=

# ── 5. Google Sheets Customer Sync (Optional) ──
# Syncs customer name and mobile to Google Sheets in the background on order creation.
# Ensure your Google Sheet is shared with Editor permission to your Google Cloud Service Account
# (e.g. aarisha-sheets-sync@the-aarisha.iam.gserviceaccount.com).
GOOGLE_SPREADSHEET_ID=
# Path to Google Service Account JSON file (relative to backend/ or absolute):
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Or raw JSON string of the service account credentials (for Vercel environment variables):
GOOGLE_SERVICE_ACCOUNT_JSON=
