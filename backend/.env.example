[TEMPLATE]
# Never commit a populated .env file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
BRAND_WHATSAPP_NUMBER=919924343003
# Comma-separated browser origins. Do not use * in production.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Optional: 60-day long-lived Instagram Basic Display access token (Meta).
# Leave empty to show placeholder tiles in the Instagram section.
INSTAGRAM_ACCESS_TOKEN=
# Optional: Google Sheets Customer Sync (Google Cloud Console Service Account)
GOOGLE_SPREADSHEET_ID=
# Path to service account json file (relative to backend/ or absolute)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Or raw JSON string of service account key (useful for cloud environments like Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=

